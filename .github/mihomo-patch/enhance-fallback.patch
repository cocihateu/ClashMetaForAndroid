+const (
+	fallbackStaggerDelay       = 1500 * time.Millisecond
+	fallbackMaxDialAttempts    = 3
+	fallbackStallThreshold     = 4 * time.Second
+	fallbackProbeTimeout       = 3 * time.Second
+	fallbackHostWindow         = 60 * time.Second
+	fallbackHostThreshold      = 3
+	fallbackBaseCooldown       = 30 * time.Second
