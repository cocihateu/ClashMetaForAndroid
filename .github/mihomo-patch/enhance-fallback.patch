+	cooldownUntil time.Time
+	backoffLevel  int
+	probing       bool
+}
+
+type fallbackObserverConn struct {
+	C.Conn
+	stallTimeout time.Duration
+	closed       atomic.Bool
+	done         atomic.Bool
+	timer        atomic.Pointer[time.Timer]
+	onSuccess    func()
+	onSuspect    func(err error, strong bool)
+}
+
+func (c *fallbackObserverConn) armWatchdog() {
+	if c.done.Load() || c.closed.Load() || c.timer.Load() != nil {
+		return
+	}
+	timeout := c.stallTimeout
+	if timeout <= 0 {
+		timeout = fallbackStallThreshold
+	}
+	t := time.AfterFunc(timeout, func() {
+		if !c.closed.Load() && c.done.CompareAndSwap(false, true) && c.onSuspect != nil {
+			c.onSuspect(context.DeadlineExceeded, true)
+		}
+	})
+	if !c.timer.CompareAndSwap(nil, t) {
+		t.Stop()
+	} else if c.done.Load() || c.closed.Load() {
+		t.Stop()
+	}
+}
+
+func (c *fallbackObserverConn) stopWatchdog() {
+	if t := c.timer.Swap(nil); t != nil {
+		t.Stop()
+	}
+}
+
+func (c *fallbackObserverConn) markSuccess() {
+	c.stopWatchdog()
+	if c.done.CompareAndSwap(false, true) && c.onSuccess != nil {
+		c.onSuccess()
+	}
+}
+
+func (c *fallbackObserverConn) markError(err error) {
+	c.stopWatchdog()
+	if err == nil || c.closed.Load() || isIgnoredFallbackError(err) {
+		return
+	}
+	if c.done.CompareAndSwap(false, true) && c.onSuspect != nil {
+		c.onSuspect(err, isStrongFallbackError(err))
+	}
+}
+
+func (c *fallbackObserverConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if !c.done.Load() {
+		if n > 0 {
+			c.markSuccess()
+		} else if err != nil {
+			c.markError(err)
+		}
+	}
+	return n, err
+}
+
+func (c *fallbackObserverConn) ReadBuffer(buffer *buf.Buffer) error {
+	before := buffer.Len()
+	err := c.Conn.ReadBuffer(buffer)
+	if !c.done.Load() {
+		if buffer.Len() > before {
+			c.markSuccess()
+		} else if err != nil {
+			c.markError(err)
+		}
+	}
+	return err
+}
+
+func (c *fallbackObserverConn) Write(b []byte) (int, error) {
+	n, err := c.Conn.Write(b)
+	if !c.done.Load() {
+		if err != nil {
+			c.markError(err)
+		} else if n > 0 {
+			c.armWatchdog()
+		}
+	}
+	return n, err
+}
+
+func (c *fallbackObserverConn) WriteBuffer(buffer *buf.Buffer) error {
+	dataLen := buffer.Len()
+	err := c.Conn.WriteBuffer(buffer)
+	if !c.done.Load() {
+		if err != nil {
+			c.markError(err)
+		} else if dataLen > 0 {
+			c.armWatchdog()
+		}
+	}
+	return err
+}
+
+func (c *fallbackObserverConn) Close() error {
+	c.closed.Store(true)
+	c.stopWatchdog()
+	return c.Conn.Close()
+}
+
+func (c *fallbackObserverConn) ReaderReplaceable() bool {
+	return c.done.Load()
+}
+
+func (c *fallbackObserverConn) WriterReplaceable() bool {
+	return c.done.Load()
+}
+
+func (c *fallbackObserverConn) Upstream() any {
+	return c.Conn
+}
+
+var _ N.ExtendedConn = (*fallbackObserverConn)(nil)
+
+func isIgnoredFallbackError(err error) bool {
+	return errors.Is(err, context.Canceled) ||
+		errors.Is(err, C.ErrNotSupport) ||
+		errors.Is(err, net.ErrClosed)
+}
+
+func isStrongFallbackError(err error) bool {
+	if errors.Is(err, context.DeadlineExceeded) {
+		return true
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return true
+	}
+	msg := strings.ToLower(err.Error())
+	return strings.Contains(msg, "connection reset") ||
+		strings.Contains(msg, "broken pipe") ||
+		strings.Contains(msg, "connection refused") ||
+		strings.Contains(msg, "i/o timeout")
+}
+
+func metadataHostKey(metadata *C.Metadata) string {
+	if metadata == nil {
+		return ""
+	}
+	if metadata.Host != "" {
+		return strings.ToLower(metadata.Host)
+	}
+	if metadata.DstIP.IsValid() {
+		return metadata.DstIP.String()
+	}
+	return metadata.RemoteAddress()
+}
