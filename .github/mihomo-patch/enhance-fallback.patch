+func (f *Fallback) isDemotedLocked(name string, now time.Time) bool {
+	st, ok := f.proxyStates[name]
+	if !ok {
+		return false
+	}
+	return now.Before(st.cooldownUntil)
+}
+
+func (f *Fallback) demoteProxy(proxy C.Proxy, reason string) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	name := proxy.Name()
+
+	f.stateMux.Lock()
+	if f.proxyStates == nil {
+		f.proxyStates = make(map[string]*proxyFailState)
+	}
+	st, ok := f.proxyStates[name]
+	if !ok {
+		st = &proxyFailState{}
+		f.proxyStates[name] = st
+	}
+
+	// Avoid escalating backoff multiple times within an already-active cooldown.
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	cooldown := f.effectiveBaseCooldown() << uint(st.backoffLevel)
+	if cooldown > fallbackMaxCooldown {
+		cooldown = fallbackMaxCooldown
+	}
+	if st.backoffLevel < 4 {
+		st.backoffLevel++
+	}
+	st.cooldownUntil = now.Add(cooldown)
+	st.suspectHosts = nil
+	if f.selected == name {
+		f.selected = ""
+	}
+	f.stateMux.Unlock()
+
+	log.Warnln("Fallback[%s]: proxy %s demoted for %v (%s)", f.Name(), name, cooldown, reason)
+	go f.closeConnectionsForProxy(name)
+}
+
+func (f *Fallback) closeConnectionsForProxy(proxyName string) {
+	groupName := f.Name()
+	var toClose []statistic.Tracker
+	statistic.DefaultManager.Range(func(c statistic.Tracker) bool {
+		info := c.Info()
+		if info == nil {
+			return true
+		}
+		hasGroup := false
+		hasProxy := false
+		for _, chainName := range info.Chain {
+			if chainName == groupName {
+				hasGroup = true
+			} else if chainName == proxyName {
+				hasProxy = true
+			}
+		}
+		if hasGroup && hasProxy {
+			toClose = append(toClose, c)
+		}
+		return true
+	})
+
+	for _, c := range toClose {
+		_ = c.Close()
+	}
+	if len(toClose) > 0 {
+		log.Warnln("Fallback[%s]: closed %d active connections on demoted proxy %s", groupName, len(toClose), proxyName)
+	}
+}
+
+func (f *Fallback) reportSuspect(proxy C.Proxy, host string, strong bool) {
+	if proxy == nil || isSkippableAdapter(proxy.Type()) {
+		return
+	}
+
+	now := time.Now()
+	name := proxy.Name()
+	if host == "" {
+		host = "_unknown_"
+	}
+
+	shouldDemoteMultiHost := false
+	shouldProbe := false
+
+	f.stateMux.Lock()
+	if f.proxyStates == nil {
+		f.proxyStates = make(map[string]*proxyFailState)
+	}
+	st, ok := f.proxyStates[name]
+	if !ok {
+		st = &proxyFailState{}
+		f.proxyStates[name] = st
+	}
+
+	if now.Before(st.cooldownUntil) {
+		f.stateMux.Unlock()
+		return
+	}
+
+	if st.suspectHosts == nil {
+		st.suspectHosts = make(map[string]time.Time)
+	}
+	for h, ts := range st.suspectHosts {
+		if now.Sub(ts) > fallbackHostWindow {
+			delete(st.suspectHosts, h)
+		}
+	}
+	st.suspectHosts[host] = now
+
+	if len(st.suspectHosts) >= fallbackHostThreshold {
+		shouldDemoteMultiHost = true
+	} else if (strong || len(st.suspectHosts) >= 2) && !st.probing {
+		st.probing = true
+		shouldProbe = true
+	}
+	f.stateMux.Unlock()
+
+	if shouldDemoteMultiHost {
+		f.demoteProxy(proxy, "multiple distinct hosts stalled/failed")
+		return
+	}
+
+	if shouldProbe {
+		go func() {
+			defer func() {
+				f.stateMux.Lock()
+				if st, ok := f.proxyStates[name]; ok {
+					st.probing = false
+				}
+				f.stateMux.Unlock()
+			}()
+
+			ctx, cancel := context.WithTimeout(context.Background(), f.effectiveProbeTimeout())
+			defer cancel()
+			expectedStatus, _ := utils.NewUnsignedRanges[uint16](f.expectedStatus)
+			if _, err := proxy.URLTest(ctx, f.testUrl, expectedStatus); err != nil {
+				f.demoteProxy(proxy, "targeted URLTest failed: "+err.Error())
+			}
+		}()
+	}
+}
+
+func (f *Fallback) recordProxySuccess(proxy C.Proxy) {
+	if proxy == nil {
+		return
+	}
+
+	now := time.Now()
+	name := proxy.Name()
+
+	f.stateMux.Lock()
+	if st, ok := f.proxyStates[name]; ok {
+		// Never clear an active cooldown due to a late response from an older connection.
+		if now.Before(st.cooldownUntil) {
+			f.stateMux.Unlock()
+			return
+		}
+		st.suspectHosts = nil
+		if st.backoffLevel > 0 && !st.cooldownUntil.IsZero() && now.Sub(st.cooldownUntil) >= f.effectiveRecoveryWindow() {
+			st.backoffLevel--
+			st.cooldownUntil = now
+		}
+	}
+	f.stateMux.Unlock()
+
+	f.onDialSuccess()
+}
+
+func (f *Fallback) wrapObservedConn(c C.Conn, proxy C.Proxy, host string) C.Conn {
+	c.AppendToChains(f)
+	if N.NeedHandshake(c) {
+		p := proxy
+		c = callback.NewFirstWriteCallBackConn(c, func(wErr error) {
+			if wErr == nil {
+				f.recordProxySuccess(p)
+			} else if !isIgnoredFallbackError(wErr) {
+				f.reportSuspect(p, host, true)
+			}
+		})
+	}
+	if !isSkippableAdapter(proxy.Type()) {
+		p := proxy
+		c = &fallbackObserverConn{
+			Conn:         c,
+			stallTimeout: f.effectiveStallTimeout(),
+			onSuccess: func() {
+				f.recordProxySuccess(p)
+			},
+			onSuspect: func(ioErr error, strong bool) {
+				f.reportSuspect(p, host, strong)
+			},
+		}
+	}
+	return c
 }
 
